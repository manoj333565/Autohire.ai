# ==============================================================================
# CAREERPILOT AI / AUTOHIRE.AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your sensitive credentials.
# NEVER commit the actual '.env' file to Git or version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM CONFIGURATION (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_RPM=12
GEMINI_DELAY_BETWEEN_CALLS=5

# ------------------------------------------------------------------------------
# 2. GMAIL INTEGRATION (SMTP & IMAP)
# ------------------------------------------------------------------------------
# Use a dedicated Gmail address for applications (separate from your primary email)
# Create a 16-character App Password at:
# Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_ADDRESS=your_job_agent_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
PERSONAL_EMAIL=manojkumarmandal1111@gmail.com

# ------------------------------------------------------------------------------
# 3. SAFETY, EXECUTION & RATE LIMITS
# ------------------------------------------------------------------------------
# DRY_RUN=True prevents real applications from being submitted and emails sent
DRY_RUN=True
REQUIRE_HUMAN_APPROVAL=True
MAX_APPLY_PER_DAY=30
MAX_EMAIL_PER_DAY=25
EMAIL_DELAY_SECONDS=20
MATCH_SCORE_THRESHOLD=7.0

# ------------------------------------------------------------------------------
# 4. SCHEDULER & TIMEZONE CONFIGURATION
# ------------------------------------------------------------------------------
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 5. DASHBOARD & SECURITY
# ------------------------------------------------------------------------------
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=careerpilot_super_secret_session_key_2026
DASHBOARD_PASSWORD=autohire_admin_pass

# ------------------------------------------------------------------------------
# 6. HR DISCOVERY & ENRICHMENT APIS (Optional - Graceful Fallbacks)
# ------------------------------------------------------------------------------
APOLLO_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
TAVILY_API_KEY=
TAVILY_DAILY_LIMIT=30

# ------------------------------------------------------------------------------
# 7. CROSS-SESSION MEMORY (Optional - SQLite is primary)
# ------------------------------------------------------------------------------
MEM0_API_KEY=
MEM0_USER_ID=manoj_careerpilot_001

# ------------------------------------------------------------------------------
# 8. PORTAL CREDENTIALS (Optional - For Playwright Assisted Sessions)
# ------------------------------------------------------------------------------
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
BROWSER_HEADLESS=True
